# Kopieren nach /etc/ct-summary-button.env (chmod 600). Enthält ein Geheimnis, nicht ins Git!

# Auslöse-URL aus der GUI-Seite "Sammelausdrucke" (enthält den Token)
TRIGGER_URL=http://localhost:3000/api/summary-trigger/<TOKEN>

# Secret aus der GUI-Seite "Sammelausdrucke"
TRIGGER_SECRET=<SECRET>

# Optional (Standardwerte)
#BUTTON_PIN=17
#LED_PIN=27
