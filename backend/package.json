{
  "name": "ct-checkin-printer-v2-backend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@churchtools/churchtools-client": "^1.5.4",
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/session": "^11.1.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.0.2",
    "@napi-rs/canvas": "^0.1.100",
    "axios-cookiejar-support": "^7.0.0",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.9.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "ipp": "^1.1.0",
    "pdfkit": "^0.20.2",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "tough-cookie": "^6.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/ipp": "^2.0.5",
    "@types/node": "^22.13.5",
    "@types/pdfkit": "^0.17.6",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.5",
    "drizzle-kit": "^0.30.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
