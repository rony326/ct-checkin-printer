# Nur technische Bootstrap-Werte — alle fachlichen Einstellungen (ChurchTools,
# Drucker, Webhooks, Etiketten-Layouts, ...) werden über das Web-GUI verwaltet
# und verschlüsselt in der SQLite-DB abgelegt.

DB_PATH=./data/app.db
APP_PORT=3000
APP_HOST=0.0.0.0

# Beide mit z.B. `openssl rand -base64 32` erzeugen:
ENCRYPTION_KEY=
SESSION_SECRET=

LOG_LEVEL=info
