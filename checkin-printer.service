[Unit]
Description=ChurchTools Check-In Printer Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/checkin-printer
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=10             # 10s warten vor Neustart
StartLimitIntervalSec=300 # innerhalb 5 Minuten
StartLimitBurst=5         # max. 5 Neustarts — danach stoppt systemd
StandardOutput=journal
StandardError=journal
SyslogIdentifier=checkin-printer

[Install]
WantedBy=multi-user.target